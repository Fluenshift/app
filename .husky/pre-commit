#!/bin/sh
# Format and lint the staged files only; `pnpm verify` covers the whole tree.
set -e

git diff --cached --name-only -z --diff-filter=ACMR |
  xargs -0 -r pnpm exec oxfmt --check --no-error-on-unmatched-pattern

git diff --cached --name-only -z --diff-filter=ACMR |
  xargs -0 -r pnpm exec oxlint --no-error-on-unmatched-pattern
