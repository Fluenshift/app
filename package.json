{
  "name": "grifando",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "tsc --noEmit -p scripts/tsconfig.json && turbo run check-types",
    "check:docs": "node scripts/check-doc-commands.ts",
    "check:effect": "turbo run check:effect",
    "check:gates": "node scripts/check-gates.ts",
    "check:url-text": "node scripts/check-url-text.ts",
    "db:generate": "pnpm --filter @grifando/db run db:generate",
    "dev": "turbo run dev",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "docker:smoke": "pnpm --filter smoke run smoke",
    "docker:up": "mkdir -p .data && GRIFANDO_UID=$(id -u) GRIFANDO_GID=$(id -g) docker compose up --detach --build",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint --deny-warnings",
    "lint:effect": "oxlint --deny-warnings --config oxlint.effect.config.ts apps/server packages/contract packages/core packages/db packages/env",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint",
    "test": "pnpm test:scripts && turbo run test",
    "test:postgres": "pnpm --filter @grifando/db run test:postgres",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "verify": "pnpm format && pnpm check:docs && pnpm check:gates && pnpm check:url-text && pnpm lint && pnpm lint:effect && pnpm check-types && pnpm check:effect && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.18.0"
}
