{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "packages/config/*.json",
    "pnpm-lock.yaml",
    ".node-version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {},
    "check:effect": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
